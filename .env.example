# Configuration BBIA-SIM
# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement

# Environnement (dev/prod) — canonique BBIA_ENVIRONMENT ; alias BBIA_ENV
BBIA_ENV=dev
# BBIA_ENVIRONMENT=prod

# Token d'authentification API (CHANGEZ EN PRODUCTION !)
# Canonique : BBIA_API_TOKEN — alias historique : BBIA_TOKEN
# En prod, le défaut ci-dessous est REFUSÉ au démarrage.
BBIA_TOKEN=bbia-secret-key-dev
# BBIA_API_TOKEN=change-me-to-a-long-random-secret

# Configuration serveur — canonique BBIA_API_HOST/PORT/RELOAD ; alias HOST/PORT/RELOAD
BBIA_HOST=0.0.0.0
BBIA_PORT=8000
BBIA_RELOAD=true

# Configuration simulation
BBIA_SIM_MODEL_PATH=src/bbia_sim/sim/models/reachy_mini.xml
BBIA_SIM_HEADLESS=true
BBIA_SIM_STEP_FREQUENCY=0.01

# Configuration CORS (prod uniquement)
BBIA_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Configuration logs
BBIA_LOG_LEVEL=INFO
BBIA_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuration télémétrie WebSocket
BBIA_TELEMETRY_FREQUENCY=10.0
BBIA_TELEMETRY_ENABLED=true

# HF apps : pip install -r après clone — OFF par défaut (code arbitraire)
# BBIA_HF_PIP_INSTALL=1

# Sécurité robot physique (OFF par défaut)
# Sans BBIA_ALLOW_HARDWARE=1 : simulation uniquement, aucun ReachyMini() matériel
# Voir docs/hardware/PREMIER_JOUR_ROBOT.md
# BBIA_ALLOW_HARDWARE=1
# BBIA_TELEMETRY_SDK=false
